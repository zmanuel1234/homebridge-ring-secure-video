{
  "name": "homebridge-ring-secure-video",
  "displayName": "Ring Secure Video",
  "version": "1.2.3",
  "description": "Homebridge plugin for Ring devices with HomeKit Secure Video recording, based on homebridge-ring and homebridge-ring-hksv",
  "type": "module",
  "main": "./lib/index.js",
  "exports": "./lib/index.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\" && tsc && node -e \"require('fs').cpSync('./homebridge-ui/public', './lib/homebridge-ui/public', { recursive: true, filter: (src) => require('path').basename(src) !== 'tsconfig.json' })\"",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run lint && npm run build",
    "dev": "concurrently -c yellow,blue --kill-others \"npm:dev:build\" \"npm:dev:run\" ",
    "dev:build": "tsc --watch --preserveWatchOutput",
    "dev:run": "RING_DEBUG=true node --watch ./node_modules/.bin/homebridge -U ./.homebridge -P ./node_modules",
    "verify": "npm run lint && npm test && node .github/scripts/check-homebridge.mjs && node .github/scripts/check-config-schema.mjs",
    "test:matrix": "npm test",
    "release:check": "npm run verify && node .github/scripts/check-homebridge.mjs --release"
  },
  "dependencies": {
    "@homebridge/camera-utils": "^3.0.0",
    "@homebridge/plugin-ui-utils": "^2.3.0",
    "ring-client-api": "15.0.0-beta.0",
    "rxjs": "^7.8.2",
    "werift": "0.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "ajv": "8.20.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "homebridge": "^2.5.0",
    "homebridge-config-ui-x": "^5.24.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "homebridge": {
    "pluginAlias": "Ring Secure Video",
    "pluginType": "platform"
  },
  "author": "Manuel Zamfir",
  "contributors": [
    "Dusty Greif (homebridge-ring)",
    "trinityhades (homebridge-ring-hksv)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmanuel1234/homebridge-ring-secure-video.git"
  },
  "bugs": {
    "url": "https://github.com/zmanuel1234/homebridge-ring-secure-video/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/zmanuel1234"
    },
    {
      "type": "buymeacoffee",
      "url": "https://www.buymeacoffee.com/zmanuel"
    }
  ],
  "homepage": "https://github.com/zmanuel1234/homebridge-ring-secure-video#readme",
  "files": [
    "CHANGELOG.md",
    "config.schema.json",
    "lib",
    "media"
  ],
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "supports-hap",
    "ring",
    "hksv",
    "homekit-secure-video",
    "doorbell",
    "doorbot",
    "camera",
    "alarm",
    "smart",
    "light",
    "beam",
    "security",
    "category-security",
    "category-lighting",
    "category-video",
    "category-hubs",
    "category-outdoor"
  ],
  "allowScripts": {
    "ffmpeg-for-homebridge@2.2.2": true,
    "protobufjs@7.6.6": true
  }
}
