{
  "name": "homebridge-ring-secure-video",
  "displayName": "Ring Secure Video",
  "version": "1.5.0",
  "description": "Ring in HomeKit with HomeKit Secure Video recording: doorbells, cameras, alarm, sensors, locks and lights. One plugin that replaces homebridge-ring.",
  "author": "Manuel Zamfir",
  "contributors": [
    "Dusty Greif (homebridge-ring)",
    "trinityhades (homebridge-ring-hksv)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/zmanuel1234/homebridge-ring-secure-video#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmanuel1234/homebridge-ring-secure-video.git"
  },
  "bugs": {
    "url": "https://github.com/zmanuel1234/homebridge-ring-secure-video/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/zmanuel1234"
    },
    {
      "type": "buymeacoffee",
      "url": "https://www.buymeacoffee.com/zmanuel"
    }
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "media",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/homebridge-ui/public','dist/homebridge-ui/public',{recursive:true,filter:(src)=>require('path').basename(src)!=='tsconfig.json'})\"",
    "check": "tsc -p .",
    "lint": "oxlint",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify",
    "verify": "npm run check && npm run lint && npm run build && npm test && node .github/scripts/check-homebridge.mjs && node .github/scripts/check-config-schema.mjs",
    "test:matrix": "npm run build && npm test",
    "release:check": "npm run verify && node .github/scripts/check-homebridge.mjs --release",
    "watch": "npm run build && npm link && nodemon"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "supports-hap",
    "ring",
    "hksv",
    "homekit-secure-video",
    "doorbell",
    "doorbot",
    "camera",
    "alarm",
    "smart",
    "light",
    "beam",
    "security",
    "category-security",
    "category-lighting",
    "category-video",
    "category-hubs",
    "category-outdoor",
    "ring-doorbell",
    "ring-alarm",
    "ring-camera",
    "home-security",
    "lock"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.0.0"
  },
  "dependencies": {
    "@homebridge/camera-utils": "^3.0.0",
    "@homebridge/plugin-ui-utils": "^2.3.0",
    "ring-client-api": "15.0.0-beta.0",
    "rxjs": "^7.8.2",
    "werift": "0.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "8.20.0",
    "homebridge": "^2.5.0",
    "nodemon": "^3.1.14",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.9"
    }
  },
  "homebridge": {
    "pluginAlias": "Ring Secure Video",
    "pluginType": "platform"
  },
  "allowScripts": {
    "ffmpeg-for-homebridge@2.2.2": true,
    "protobufjs@7.6.6": true
  }
}
